# =============================================================================
# Caddy como puerta de entrada unica a Virthub
# =============================================================================
#
# Escenario: Cloudflare Tunnel. El tunel apunta TODOS los nombres a este Caddy
# y Caddy decide a donde va cada uno, despues de comprobar el acceso.
#
# Por que importa: si el tunel apunta directamente a los escritorios (como
# estaba antes: ct0 -> 127.0.0.1:8006), se salta esta comprobacion y cualquiera
# con la URL entra al escritorio.
#
# Escucha en 8080 en http porque el tunel ya termina el TLS: no hacen falta
# certificados aqui, y asi Caddy no necesita salida a internet.
#
# Antes de usarlo, en el .env de la aplicacion:
#   SESSION_DOMAIN=.virthub.dpdns.org
# para que la cookie de sesion valga tambien en los subdominios.
{
	# Sin TLS propio: el tunel ya cifra.
	auto_https off

	# Caddy corre como usuario sin privilegios dentro del contenedor.
	admin off
}

# -----------------------------------------------------------------------------
# Credenciales de los escritorios, inyectadas por el proxy
# -----------------------------------------------------------------------------
#
# El contenedor Webtop puede exigir autenticacion propia (nginx basic auth). En
# lugar de que el navegador la pida --lo que dibujaria un dialogo del sistema
# sobre TODA la aplicacion, no dentro del iframe--, es Caddy quien la presenta:
#
#   header_up Authorization "Basic <base64 usuario:contrasena>"
#
# Ventajas:
#   - El navegador nunca muestra el dialogo: para el, /escritorio/ no pide nada.
#   - El contenedor sigue protegido: sin esa cabecera responde 401, y como no
#     publica puertos ni tiene subdominio, no hay forma de llegar a el sin pasar
#     por aqui.
#   - El WebSocket tambien la recibe, porque forward_auth y reverse_proxy la
#     aplican a todas las peticiones de la ruta.
#
# El valor se calcula en docker/caddy-entrypoint.sh a partir de
# CONTAINER_AUTH_USER y CONTAINER_AUTH_PASSWORD del .env. Si no hay contrasena,
# la cabecera va vacia y el contenedor no pide nada.
(escritorio_auth) {
	header_up Authorization "{env.CADDY_BASIC_AUTH}"
}

# -----------------------------------------------------------------------------
# Sitio principal: la aplicacion
# -----------------------------------------------------------------------------

http://virthub.dpdns.org:8080 {
	encode zstd gzip

	# El punto de control del proxy NUNCA debe ser alcanzable desde fuera. Solo
	# lo llama Caddy internamente a traves de forward_auth.
	@interno path /internal/proxy-auth*
	handle @interno {
		respond "Not found" 404
	}

	# -------------------------------------------------------------------------
	# Escritorios servidos por el MISMO dominio, uno por ruta
	# -------------------------------------------------------------------------
	#
	# Asi el navegador nunca conecta al dominio del contenedor: en el inspector
	# aparece virthub.dpdns.org/escritorio/ y no ct0.virthub.dpdns.org.
	#
	# handle_path quita el prefijo antes de reenviar, de modo que el contenedor
	# recibe / y sus rutas relativas resuelven. Esta comprobado que KasmVNC
	# deriva el prefijo de la propia URL, asi que su WebSocket va a
	# /escritorio/websockets y tambien pasa por aqui.
	#
	# Cada escritorio necesita su propio bloque: handle_path solo quita UN prefijo
	# y KasmVNC deriva el suyo de la URL completa, asi que una ruta comodin
	# (/escritorio/*/ ) no funcionaria.
	#
	# Para anadir un escritorio: una linea como las de abajo. El identificador
	# debe coincidir con el nombre del servicio en docker-compose.yml y con el
	# valor de CONTAINER_CT<n> en el .env.

	# --- ct0 (usuarios administradores) ---
	@escritorio_ct0 path /escritorio/*
	handle @escritorio_ct0 {
		forward_auth app:80 {
			uri /internal/proxy-auth
			header_up X-Container ct0
			copy_headers X-Virthub-User X-Virthub-Container
		}

		handle_path /escritorio/* {
			reverse_proxy ct0:3000 {
				# Presenta las credenciales del escritorio: el navegador no las
				# ve ni las pide, pero el contenedor si las recibe.
				import escritorio_auth

				header_up X-Real-IP {http.request.header.CF-Connecting-IP}
				header_up X-Forwarded-Proto https
			}
		}
	}

	# --- ct2 ---
	@escritorio_ct2 path /escritorio/ct2/*
	handle @escritorio_ct2 {
		forward_auth app:80 {
			uri /internal/proxy-auth
			header_up X-Container ct2
			copy_headers X-Virthub-User X-Virthub-Container
		}

		handle_path /escritorio/ct2/* {
			reverse_proxy ct2:3000 {
				import escritorio_auth
				header_up X-Real-IP {http.request.header.CF-Connecting-IP}
				header_up X-Forwarded-Proto https
			}
		}
	}

	# --- ct3 ---
	@escritorio_ct3 path /escritorio/ct3/*
	handle @escritorio_ct3 {
		forward_auth app:80 {
			uri /internal/proxy-auth
			header_up X-Container ct3
			copy_headers X-Virthub-User X-Virthub-Container
		}

		handle_path /escritorio/ct3/* {
			reverse_proxy ct3:3000 {
				import escritorio_auth
				header_up X-Real-IP {http.request.header.CF-Connecting-IP}
				header_up X-Forwarded-Proto https
			}
		}
	}

	handle {
		reverse_proxy app:80 {
			header_up X-Real-IP {http.request.header.CF-Connecting-IP}

			# El tunel entrega en http porque ya termino el TLS. Sin esta cabecera
			# la aplicacion creeria que el usuario navega por http y generaria
			# enlaces http://, lo que rompe recursos y redirecciones.
			header_up X-Forwarded-Proto https
		}
	}
}

# -----------------------------------------------------------------------------
# Fragmento compartido
# -----------------------------------------------------------------------------
#
# Debe estar DEFINIDO antes de usarse: Caddy lee el archivo de arriba abajo.

(webtop_proxy) {
	# forward_auth manda una subpeticion a la aplicacion conservando la cookie de
	# sesion. Si responde 2xx, la peticion continua; si responde otra cosa, esa
	# respuesta se devuelve tal cual (403 sin sesion o con escritorio ajeno).
	forward_auth app:80 {
		uri /internal/proxy-auth

		# El destino lo pone Caddy, no el cliente: asi nadie puede pedir el
		# escritorio de otro cambiando una cabecera.
		header_up X-Container {args[0]}

		# La respuesta no debe filtrar detalles internos.
		copy_headers X-Virthub-User X-Virthub-Container
	}

	reverse_proxy {args[1]} {
		# Webtop usa WebSocket para noVNC. Caddy gestiona el upgrade, pero el
		# tunel tambien tiene que permitir WebSocket.
		header_up X-Real-IP {http.request.header.CF-Connecting-IP}
		header_up X-Forwarded-Proto https
	}
}

# -----------------------------------------------------------------------------
# Los subdominios ct* QUEDAN DESHABILITADOS a proposito
# -----------------------------------------------------------------------------
#
# Antes existia un bloque por contenedor (ct0.virthub.dpdns.org -> ct0:3000).
# Se elimino porque permitia saltarse la aplicacion:
#
#   La cookie de sesion vive en .virthub.dpdns.org, asi que el navegador la
#   envia TAMBIEN a ct0.virthub.dpdns.org. Caddy la veia valida y entregaba el
#   escritorio por esa direccion, sin pasar por /escritorio/ ni por la pagina
#   que lo aloja. Cualquier usuario con sesion abierta podia entrar por ahi.
#
# El escritorio se sirve ahora SOLO por /escritorio/ del dominio principal (ver
# el bloque de arriba), de modo que no existe una segunda puerta.
#
# Si en el futuro se quiere un escritorio por subdominio, hay que impedir que la
# cookie de la aplicacion viaje a ese subdominio (por ejemplo con un dominio
# distinto para los escritorios) o la comprobacion de acceso volvera a ser
# inutil, porque se autenticaria sola con la sesion del usuario.

# -----------------------------------------------------------------------------
# Cualquier otro nombre: no existe
# -----------------------------------------------------------------------------
#
# Red de seguridad para no dejar puertas abiertas. Si queda algun registro DNS
# apuntando a este Caddy (los ct* del tunel, por ejemplo) responde 404 en lugar
# de entregar un escritorio o la aplicacion.

http://:8080 {
	respond "Not found" 404
}
