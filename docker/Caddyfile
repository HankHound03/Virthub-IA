# =============================================================================
# Caddy como puerta de entrada unica a Virthub
# =============================================================================
#
# Escenario: Cloudflare Tunnel. El tunel apunta TODOS los nombres a este Caddy
# y Caddy decide a donde va cada uno, despues de comprobar el acceso.
#
# Por que importa: si el tunel apunta directamente a los escritorios (como
# estaba antes: ct0 -> 127.0.0.1:8006), se salta esta comprobacion y cualquiera
# con la URL entra al escritorio.
#
# Escucha en 8080 en http porque el tunel ya termina el TLS: no hacen falta
# certificados aqui, y asi Caddy no necesita salida a internet.
#
# Antes de usarlo, en el .env de la aplicacion:
#   SESSION_DOMAIN=.virthub.dpdns.org
# para que la cookie de sesion valga tambien en los subdominios.
{
	# Sin TLS propio: el tunel ya cifra.
	auto_https off

	# Caddy corre como usuario sin privilegios dentro del contenedor.
	admin off
}

# -----------------------------------------------------------------------------
# Sobre la autenticacion de los escritorios
# -----------------------------------------------------------------------------
#
# Los escritorios NO piden credenciales propias. La proteccion es la comprobacion
# de sesion que hace la aplicacion a traves de forward_auth:
#
#   - Sin sesion valida -> 403, y el contenedor ni se toca.
#   - Con sesion pero pidiendo el escritorio de otro -> 403.
#
# Se probo a añadir autenticacion propia al contenedor (nginx basic auth) y
# funciona, pero terminaba pidiendo usuario y contrasena en cada acceso y no
# aportaba nada frente a la comprobacion de sesion, que ya deja el contenedor
# inalcanzable desde fuera: no publica puertos y el tunel no lo conoce.
#
# Si algun dia se quiere reactivar: define CUSTOM_USER y PASSWORD en el servicio
# del escritorio (docker-compose.yml). Caddy debera presentar entonces la
# cabecera Authorization, porque el dialogo del navegador taparia la aplicacion.

# -----------------------------------------------------------------------------
# Sitio principal: la aplicacion
# -----------------------------------------------------------------------------

http://virthub.dpdns.org:8080 {
	encode zstd gzip

	# El punto de control del proxy NUNCA debe ser alcanzable desde fuera. Solo
	# lo llama Caddy internamente a traves de forward_auth.
	@interno path /internal/proxy-auth*
	handle @interno {
		respond "Not found" 404
	}

	# -------------------------------------------------------------------------
	handle {
		reverse_proxy app:80 {
			header_up X-Real-IP {http.request.header.CF-Connecting-IP}

			# El tunel entrega en http porque ya termino el TLS. Sin esta cabecera
			# la aplicacion creeria que el usuario navega por http y generaria
			# enlaces http://, lo que rompe recursos y redirecciones.
			header_up X-Forwarded-Proto https
		}
	}
}

# -----------------------------------------------------------------------------
# Fragmento compartido
# -----------------------------------------------------------------------------
#
# Debe estar DEFINIDO antes de usarse: Caddy lee el archivo de arriba abajo.

(webtop_proxy) {
	# forward_auth manda una subpeticion a la aplicacion conservando la cookie de
	# sesion y los parametros de la direccion. Si responde 2xx, la peticion
	# continua; si responde otra cosa, esa respuesta se devuelve tal cual.
	#
	# La aplicacion acepta DOS formas de identificarse:
	#   - la cookie de sesion, si llego;
	#   - el pase firmado que va en la direccion (parametro "pase").
	#
	# El pase es necesario porque la cookie no siempre viaja al subdominio del
	# escritorio: sin el, el usuario recibia 403 en su propio escritorio.
	forward_auth app:80 {
		uri /internal/proxy-auth

		# El destino lo pone Caddy, no el cliente: asi nadie puede pedir el
		# escritorio de otro cambiando una cabecera.
		header_up X-Container {args[0]}

		# La respuesta no debe filtrar detalles internos.
		copy_headers X-Virthub-User X-Virthub-Container
	}

	reverse_proxy {args[1]} {
		# Webtop usa WebSocket para noVNC. Caddy gestiona el upgrade, pero el
		# tunel tambien tiene que permitir WebSocket.
		header_up X-Real-IP {http.request.header.CF-Connecting-IP}
		header_up X-Forwarded-Proto https
	}
}

# -----------------------------------------------------------------------------
# Escritorios: un subdominio por contenedor
# -----------------------------------------------------------------------------
#
# Cada escritorio tiene su propio nombre (ct0.virthub.dpdns.org) y todos pasan
# por la comprobacion de acceso del fragmento (webtop_proxy):
#
#   - Sin sesion valida -> 403, el contenedor no se entrega.
#   - Con sesion pero pidiendo el escritorio de otro -> 403.
#   - Con sesion y siendo el suyo -> se entrega.
#
# El escritorio NO pide credenciales propias: la proteccion es esta comprobacion
# de sesion. Si algun dia se le anadieran, habria que presentarlas desde Caddy
# (el dialogo del navegador taparia la aplicacion).
#
# AVISO IMPORTANTE sobre el aislamiento:
#
#   La cookie de sesion vive en .virthub.dpdns.org, asi que el navegador la
#   envia TAMBIEN a ct0.virthub.dpdns.org. Eso significa que un usuario con
#   sesion abierta puede entrar por el subdominio sin pasar por la aplicacion:
#   la comprobacion se autentica sola con su propia sesion.
#
#   No es un agujero para terceros (sin sesion recibe 403), pero SI es una
#   segunda puerta para el propio usuario. Si se quiere cerrar, hay que servir
#   los escritorios desde un dominio distinto al de la aplicacion, para que la
#   cookie no viaje hasta ellos.

http://ct0.virthub.dpdns.org:8080 {
	import webtop_proxy ct0 ct0:3000
}

http://ct2.virthub.dpdns.org:8080 {
	import webtop_proxy ct2 ct2:3000
}

http://ct3.virthub.dpdns.org:8080 {
	import webtop_proxy ct3 ct3:3000
}

http://ct5.virthub.dpdns.org:8080 {
	import webtop_proxy ct5 ct5:3000
}

http://ct6.virthub.dpdns.org:8080 {
	import webtop_proxy ct6 ct6:3000
}

http://ct7.virthub.dpdns.org:8080 {
	import webtop_proxy ct7 ct7:3000
}

# --- ct8, ct9, ct10: escritorios del EQUIPO 2 (192.168.1.9) ---
#
# Estan en la misma red local, asi que se alcanzan por su IP y su puerto. No hace
# falta un segundo tunel: el de este equipo llega a ellos.
#
# Cada uno publica un puerto distinto en esa maquina:
#
#   ct8 -> 192.168.1.9:3000
#   ct9 -> 192.168.1.9:3100
#   ct10 -> 192.168.1.9:3200
#
# OJO: la ruta del WebSocket depende de la version de Selkies de cada imagen, y ya
# conviven dos. Comprobado con peticiones de upgrade reales:
#
#   ubuntu-xfce (Selkies antiguo)  ->  /websockets
#   ubuntu-mate (Selkies 2.0)      ->  /api/websockets
#   equipo 2 (192.168.1.9)         ->  /api/websockets
#
# Ninguna usa /api/ws: esa es la senalizacion de WebRTC y responde 409 ("WebRTC
# mode is inactive") porque corren en modo websockets. No confundirlas si algo
# deja de cargar.
#
# Caddy reenvia la ruta tal cual, asi que cada escritorio encuentra la suya sin
# configuracion adicional: solo hay que saber cual es al diagnosticar.
#
# Si su IP cambia, hay que actualizarla aqui: conviene fijarla por DHCP.

http://ct8.virthub.dpdns.org:8080 {
	import webtop_proxy ct8 192.168.1.9:3000
}

http://ct9.virthub.dpdns.org:8080 {
	import webtop_proxy ct9 192.168.1.9:3100
}

http://ct10.virthub.dpdns.org:8080 {
	import webtop_proxy ct10 192.168.1.9:3200
}

http://ct11.virthub.dpdns.org:8080 {
	import webtop_proxy ct11 192.168.1.9:3300
}

# --- ct4: ahora es un escritorio Webtop mas (clon de ct0) ---
#
# Mismo control de acceso que los Webtop, pero OJO con dos diferencias:
#
#   1. Va por el puerto 8006 (la interfaz web de la VM), no por el 3000.
#   2. El contenedor NO tiene autenticacion propia: quien llega a el, controla
#      el Windows. Aqui la comprobacion de sesion de Caddy no es una capa mas,
#      es la UNICA puerta. Antes estaba accesible en el puerto 8008 del host sin
#      pedir nada, para cualquiera en la red local.
#
# El contenedor se llama `windows7` y se conecta a esta red con el alias `ct4`:
#
#   docker network connect --alias ct4 virthub_virthub windows7
#
# Se hace asi porque el contenedor ya existia y renombrarlo obligaria a
# recrearlo. Si algun dia lo recreas, hazlo desde docker/windows7.yml (o anade
# el alias en su configuracion) para no perder el control de acceso.

http://ct4.virthub.dpdns.org:8080 {
	import webtop_proxy ct4 ct4:3000
}

# -----------------------------------------------------------------------------
# Cualquier otro nombre: no existe
# -----------------------------------------------------------------------------
#
# Red de seguridad: un registro DNS huerfano no debe acabar entregando nada.

http://:8080 {
	respond "Not found" 404
}
