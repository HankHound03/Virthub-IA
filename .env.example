APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Genera las URLs con https. Activalo SOLO si hay un proxy TLS delante
# (Cloudflare, Caddy, Traefik, nginx). Si lo activas sirviendo por http, el
# navegador pedira los CSS y JS por https, fallara y la pagina se vera sin
# estilos. APP_URL no decide esto por si solo.
FORCE_HTTPS=false

# Ollama (IA local)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
OLLAMA_SYSTEM_PROMPT="Responde en español, de forma clara, breve y útil."

ADMIN_USERNAME=admin
# Obligatoria para crear la cuenta admin desde el entorno. Si queda vacia o es
# igual al valor de ejemplo, la creacion se rechaza a proposito. La via normal
# es el instalador web con INSTALL_KEY.
ADMIN_PASSWORD=

# Clave privada necesaria para abrir el instalador por primera vez.
# Usa una cadena larga y aleatoria y no la compartas públicamente.
INSTALL_KEY=replace-with-a-long-random-key

# Permite abrir el instalador sin clave desde el propio host cuando aun no
# existe admin. Dejalo en false en produccion: con false siempre se exige la
# clave de arriba.
INSTALL_ALLOW_LOCALHOST=false

# ---------------------------------------------------------------------------
# Escritorios Webtop
# ---------------------------------------------------------------------------
# Que escritorios existen. Cada indice necesita:
#   - su servicio `ct<n>` en docker-compose.yml
#   - su declaracion CONTAINER_CT<n> aqui abajo
#   - estar en la lista de indices de abajo
#
# El indice 0 es el escritorio de administradores: los usuarios de
# CONTAINER_ADMIN_USERS van siempre ahi. El resto se reparten entre los demas.
#
# Si se declara un indice que no existe como servicio, el reparto puede mandar a
# un usuario a un escritorio que no responde. Tras cambiar esto, ejecuta:
#   php artisan virthub:sync-containers --prune
CONTAINER_INDICES=0,2,3

CONTAINER_CT0=ct0
CONTAINER_CT2=ct2
CONTAINER_CT3=ct3


# ---------------------------------------------------------------------------
# Acceso a los escritorios
# ---------------------------------------------------------------------------
# Los escritorios NO piden credenciales propias. La proteccion es la
# comprobacion de sesion que hace Caddy a traves de forward_auth:
#
#   - Sin sesion valida          -> 403, el contenedor ni se toca
#   - Pidiendo el de otro usuario -> 403
#
# El contenedor no publica puertos y el tunel no lo conoce, asi que no hay forma
# de llegar a el saltandose la comprobacion.
#
# OJO si algun dia se añade CUSTOM_USER/PASSWORD al servicio del escritorio en
# docker-compose.yml: no uses la sintaxis ${VAR:-valor}, porque Compose aplica el
# valor por defecto TAMBIEN cuando la variable esta vacia, y la autenticacion
# quedaria activa sin que te dieras cuenta.

# Carpeta del host donde vive el home de cada escritorio. Se crea una
# subcarpeta por contenedor (ct0, ct2, ct3...).
CONTAINER_DATA_DIR=C:\webtop

# Duracion de la sesion de invitado, en minutos.
GUEST_SESSION_MINUTES=30

# Ventana de presencia del chat (segundos) y tamano de pagina del foro.
CHAT_PRESENCE_WINDOW=90
CHAT_PAGE_SIZE=120

# Cache del panel de estado y tiempo de sondeo de cada contenedor.
STATUS_CACHE_SECONDS=15
STATUS_PROBE_TIMEOUT=3

# Cache de los feeds RSS del panel.
FEED_CACHE_SECONDS=300
FEED_TIMEOUT_SECONDS=8

# Container URLs - Asignación por usuario
CONTAINER_CT0=http://ct0.localhost/
CONTAINER_CT1=http://ct1.localhost/
CONTAINER_CT2=http://ct2.localhost/
CONTAINER_CT3=http://ct3.localhost/
CONTAINER_CT4=http://ct4.localhost/
CONTAINER_CT5=http://ct5.localhost/
CONTAINER_CT6=http://ct6.localhost/
CONTAINER_CT7=http://ct7.localhost/
# Usuarios con acceso a ct0: admin, hankhound03
CONTAINER_ADMIN_USERS=admin,hankhound03

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
SECURITY_LOG_LEVEL=info
SECURITY_LOG_DAYS=90

DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=virthub
DB_USERNAME=virthub
DB_PASSWORD=virthub_password
# Solo lo usa MariaDB durante el primer arranque del contenedor.
DB_ROOT_PASSWORD=root_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
